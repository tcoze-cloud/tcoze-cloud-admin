{
    "extends": "@tsconfig/node22/tsconfig.json",
    "include": [
        "vite.config.*",
        "vitest.config.*",
        "cypress.config.*",
        "nightwatch.conf.*",
        "playwright.config.*"
    ],
    "compilerOptions": {
        "composite": true,
        "noEmit": true,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
        "typeRoots": ["node_modules/@types", "types"], // 包含自定义类型目录
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "types": ["node"]
    }
}
