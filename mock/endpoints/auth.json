[
  {
    "description": "登录获取 Token（账号 admin / 123456）",
    "request": {
      "method": "POST",
      "uri": "/admin-api/auth/get-token",
      "json": {
        "username": "admin",
        "password": "123456"
      }
    },
    "response": {
      "status": 200,
      "cors": true,
      "headers": {
        "Content-Type": "application/json;charset=UTF-8"
      },
      "json": {
        "status": 0,
        "message": "登录成功",
        "data": {
          "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJhZG1pbiIsIm5hbWUiOiJhZG1pbiIsImV4cCI6NDEwMjQ0NDgwMH0.mock-signature",
          "refreshToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJhZG1pbiIsInR5cGUiOiJyZWZyZXNoIiwiZXhwIjo0MTAyNDQ0ODAwfQ.mock-signature"
        }
      }
    }
  },
  {
    "description": "登录失败（非 admin/admin 一律返回用户名或密码错误）",
    "request": {
      "method": "POST",
      "uri": "/admin-api/auth/get-token"
    },
    "response": {
      "status": 200,
      "cors": true,
      "headers": {
        "Content-Type": "application/json;charset=UTF-8"
      },
      "json": {
        "status": 1,
        "message": "用户名或密码错误",
        "data": {}
      }
    }
  },
  {
    "description": "退出登录",
    "request": {
      "method": "POST",
      "uri": "/admin-api/auth/logout"
    },
    "response": {
      "status": 200,
      "cors": true,
      "headers": {
        "Content-Type": "application/json;charset=UTF-8"
      },
      "json": {
        "status": 0,
        "message": "ok",
        "data": {}
      }
    }
  },
  {
    "description": "登录后获取菜单与权限（示例菜单：系统 > 管理员、角色）",
    "request": {
      "method": "GET",
      "uri": "/admin-api/auth/get-system-menu"
    },
    "response": {
      "status": 200,
      "cors": true,
      "headers": {
        "Content-Type": "application/json;charset=UTF-8"
      },
      "json": {
        "status": 0,
        "message": "ok",
        "data": {
          "menu": [
            {
              "path": "/system",
              "name": "system",
              "meta": {
                "title": "系统",
                "icon": "Setting"
              },
              "children": [
                {
                  "path": "admin",
                  "name": "system-admin",
                  "component": "system/admin/index",
                  "meta": {
                    "title": "管理员",
                    "icon": "User"
                  }
                },
                {
                  "path": "role",
                  "name": "system-role",
                  "component": "system/role/index",
                  "meta": {
                    "title": "角色",
                    "icon": "UserFilled"
                  }
                }
              ]
            }
          ],
          "permissions": []
        }
      }
    }
  }
]
