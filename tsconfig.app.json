{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "include": [
        "types/**/*.d.ts",
        "env.d.ts",
        "src/**/*",
        "src/**/*.vue",
        "auto-imports.d.ts",
        "components.d.ts"
    ],
    "exclude": ["src/**/__tests__/*"],
    "compilerOptions": {
        "composite": true,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

        "typeRoots": ["node_modules/@types", "types"], // 包含自定义类型目录

        "paths": {
            "@/*": ["./src/*"]
        }
    }
}
