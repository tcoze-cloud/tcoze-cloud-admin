# 正式环境环境
VITE_NODE_ENV = production

# 版本号
VITE_VUE_VERSION = 1.0.0

# 接口地址
VITE_VUE_API_BASEURL = /admin-api

# 公共基础路径
VITE_BASE_URL = ./

# 本地端口
VITE_VUE_PORT = 1235

# 是否禁止调试，建议正式环境设置true,开发环境设置为false
VITE_BAN_DEBUG = true

# SM2 国密公钥（系统端登录对 password 加密传输；须与后端 TCOZE_SM2_PRIVATE_KEY 私钥匹配）
# 生产部署请替换为正式密钥对的公钥（私钥配置在后端环境变量，见 README）
VITE_SM2_PUBLIC_KEY = 04bdb817cf9015e3d3e50f7f2c2870c5e15661cfe88902cab72afc43a198e35860858523564c1edb544758c57b75aa21c531389d75489082f1f079428a04f0ea85
